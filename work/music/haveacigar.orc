# Orquestación de "Have a Cigar" (Pink Floyd, Wish You Were Here, 1975).
# Canal 1 = bajo principal    → FM profundo N2=1, muy activo (riff de bajo)
# Canal 2 = bajo grave        → FM N2=1 aún más grave
# Canal 3 = guitarra rítmica  → FM 2.º armónico, carácter crunchy
# Canal 4 = guitarra/teclado  → FM 2.º armónico, rango amplio
# Canal 5 = sintetizador alto → FM 3.er armónico, notas agudas
# Canal 6 = órgano/sintetizador → FM sostenido, tipo Hammond
# Canal 7 = guitarra lead     → FM 2.º armónico, melodía principal
# Canal 8 = lead agudo        → FM 3.er armónico, armonías altas
1	InstrumentFM	ADSR_A=0.01; ADSR_D=0.20; ADSR_S=0.55; ADSR_R=0.10; N1=1; N2=1; I=8;
2	InstrumentFM	ADSR_A=0.01; ADSR_D=0.30; ADSR_S=0.40; ADSR_R=0.10; N1=1; N2=1; I=6;
3	InstrumentFM	ADSR_A=0.02; ADSR_D=0.15; ADSR_S=0.60; ADSR_R=0.15; N1=1; N2=2; I=12;
4	InstrumentFM	ADSR_A=0.03; ADSR_D=0.12; ADSR_S=0.65; ADSR_R=0.20; N1=1; N2=2; I=14;
5	InstrumentFM	ADSR_A=0.04; ADSR_D=0.10; ADSR_S=0.70; ADSR_R=0.18; N1=1; N2=3; I=10;
6	InstrumentFM	ADSR_A=0.06; ADSR_D=0.08; ADSR_S=0.80; ADSR_R=0.20; N1=1; N2=2; I=8;
7	InstrumentFM	ADSR_A=0.03; ADSR_D=0.12; ADSR_S=0.70; ADSR_R=0.22; N1=1; N2=2; I=16;
8	InstrumentFM	ADSR_A=0.04; ADSR_D=0.10; ADSR_S=0.65; ADSR_R=0.20; N1=1; N2=3; I=12;
